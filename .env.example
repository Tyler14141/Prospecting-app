# Copy to .env.local and fill in. All keys stay server-side.

# Required — the agents won't run without this.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Email (outbound replies, operator notifications) ---
# Uses Resend's HTTP API. Leave blank to disable sending (no-ops gracefully).
RESEND_API_KEY=
MAIL_FROM=Agentic OS <onboarding@resend.dev>
# Where digests / approved content / run summaries are sent (that's you).
OPERATOR_EMAIL=

# --- Inbound email → CEO (/api/inbound) ---
# Shared secret your email provider includes (?secret=... or x-inbound-secret).
INBOUND_SECRET=
# Optional comma-separated allowlist of senders who may trigger the agents.
INBOUND_ALLOWED_FROM=

# --- Scheduling (/api/cron) ---
# On Vercel Cron this is sent automatically as a Bearer token. Comma-separated
# workflow ids to run on schedule (defaults to scan-leads).
CRON_SECRET=
CRON_WORKFLOWS=scan-leads

# --- Auth ---
# If set, the dashboard + data APIs require HTTP Basic auth (password = this).
# /api/inbound and /api/cron are excluded (they use their own secrets above).
APP_PASSWORD=
