# Copy to .env.local and fill in. All keys stay server-side.

# Required — the agents won't run without this.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Email (outbound replies, operator notifications, real outreach sends) ---
# Uses Resend's HTTP API. Leave blank to disable sending (no-ops gracefully).
RESEND_API_KEY=
MAIL_FROM=Agentic OS <onboarding@resend.dev>
# Where digests / approved content / run summaries go, and the address that can
# reply-to-approve the daily brief (that's you).
OPERATOR_EMAIL=

# --- Inbound email (/api/inbound): CEO tasks, prospect replies, reply-to-approve ---
INBOUND_SECRET=
# Optional allowlist of senders who may trigger the agents (known leads always allowed).
INBOUND_ALLOWED_FROM=

# --- Scheduling (/api/cron daily run, /api/brief daily brief) ---
# On Vercel Cron this is sent automatically as a Bearer token.
CRON_SECRET=
CRON_WORKFLOWS=scan-leads

# --- Calendar booking ---
# Agents include this link when proposing a call/meeting.
CALENDLY_URL=

# --- Salesforce CRM (token-based; from a Connected App / session) ---
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# --- Matcha (internal contact-enrichment tool the Researcher calls) ---
MATCHA_API_URL=
MATCHA_API_KEY=

# --- Auth ---
# If set, the dashboard + data APIs require HTTP Basic auth (password = this).
# Machine endpoints (/api/inbound, /api/cron, /api/brief) use their own secrets.
APP_PASSWORD=
